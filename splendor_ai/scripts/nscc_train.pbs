#!/bin/bash
# =============================================================================
# splendor_ai — self-play training on one NSCC ASPIRE 2A "ai" node
#                (4x A100-40GB, 64 cores, 440 GB), as a SELF-CHAINING job.
#
# Submit it with:
#     qsub -P <project> -v PROJECT=<project> splendor_ai/scripts/nscc_train.pbs
#     ^ ASPIRE 2A refuses a job with no project code.  Both halves are needed:
#       -P charges THIS job, PROJECT=... is passed on so the chain can charge
#       the next one (a #PBS directive cannot read an environment variable, so
#       the script cannot fill -P in for you -- see PROJECT= below).
# A short smoke link (walltime is a directive too, so override it on the
# command line rather than editing this file):
#     qsub -P <project> -l walltime=00:30:00 \
#          -v PROJECT=<project>,TRAIN_TIMEOUT=25m,MAX_CHAIN=0 \
#          splendor_ai/scripts/nscc_train.pbs
# Watch it with:       qstat -answ1 $USER
# Stop the chain with: touch STOP            (in the repository root)
#
# HOW THIS WORKS IF YOU HAVE NEVER USED PBS
# -----------------------------------------
# PBS Pro is a batch scheduler.  `qsub` hands it this file; it waits until a
# matching node is free, then runs the file as a normal bash script on that
# node.  The `#PBS` lines below are NOT comments to PBS — they are the job's
# resource request, and they must come before the first real command.
# The maximum walltime on the ai queue is 24 h, which is shorter than this
# training run, so the job saves a checkpoint, exits, and submits *itself*
# again — the "chain".  Each link resumes from the previous one's checkpoint.
# =============================================================================

#PBS -q ai
#      ^ queue.  'ai' is the GPU queue on ASPIRE 2A (4x A100-40G per node).

#PBS -l select=1:ngpus=4:ncpus=64:mem=440gb
#      ^ resources: 1 "chunk" (= 1 node) with 4 GPUs, 64 CPU cores and 440 GB
#        of RAM.  The queue allocates 16 cores + 124 GB per GPU, so 4 GPUs is
#        the whole node: 64 cores / ~440 GB (a little under 4x124 leaves the
#        scheduler headroom).  Asking for less than a whole node here would
#        strand cores the CPU actors need.

#PBS -l walltime=23:59:00
#      ^ hard wall-clock limit.  PBS kills the job at this point, checkpoint or
#        not — which is why the training command below gets a slightly shorter
#        self-imposed timeout and exits cleanly on its own.

#PBS -N splendor-train
#      ^ job name shown by qstat.

#PBS -j oe
#      ^ join stderr into stdout, so there is ONE log file per job
#        (splendor-train.oNNNNNN in the submission directory).

## #PBS -P personal-<nusnetid>
#      ^ project/account to charge.  NSCC ASPIRE 2A REQUIRES one.  PBS reads
#        these directives before any shell expansion, so `#PBS -P $PROJECT`
#        would submit a job literally charged to "$PROJECT" -- the code has to
#        come from the qsub command line (`qsub -P personal-abc123 ...`).
#        Either uncomment this line with your code hard-wired, or pass -P;
#        the PROJECT variable below is checked at start-up either way, and is
#        what the self-chaining qsub at the bottom re-uses.

## #PBS -M you@example.com
## #PBS -m abe
#      ^ optional email on (a)bort, (b)egin, (e)nd.

set -uo pipefail
# NOTE: deliberately *not* `set -e`.  If training exits non-zero we still want
# to reach the bookkeeping and the decision about re-submitting.

# --- 1. where to run --------------------------------------------------------
# PBS starts every job in your $HOME.  $PBS_O_WORKDIR is the directory you ran
# `qsub` from — the repository root, by convention for this project.
cd "${PBS_O_WORKDIR:-$PWD}" || exit 1
REPO_ROOT="$PWD"

RUN_DIR="${RUN_DIR:-runs/nscc}"                 # trainer's run directory
CONFIG="${CONFIG:-splendor_ai/configs/nscc_4xa100.yaml}"
LOG_DIR="${RUN_DIR}/logs"
STOP_FILE="${STOP_FILE:-${REPO_ROOT}/STOP}"
ENV_NAME="${ENV_NAME:-splendor}"
# Chain bookkeeping: CHAIN counts the links so far, MAX_CHAIN caps them so a
# broken run cannot resubmit itself forever.  Both are passed to the next job
# with `qsub -v` at the bottom.  CHAIN=0,MAX_CHAIN=0 = "run once, no chaining".
CHAIN="${CHAIN:-0}"
MAX_CHAIN="${MAX_CHAIN:-30}"
# Leave the trainer 20 minutes to finish its last checkpoint before PBS's axe.
TRAIN_TIMEOUT="${TRAIN_TIMEOUT:-23h}"
# NSCC project code to charge.  Passed in with `qsub -v PROJECT=...` (and, for
# THIS job, `qsub -P ...`); the chain below hands it to its successor.  A
# submission that left it at the placeholder is stopped here, rather than
# burning a queue slot on a job PBS would reject anyway.
# PBS Pro exports the project of the running job, so a submission made with
# `qsub -P <code>` alone is accepted too; -v PROJECT=... is what keeps the
# code available for the *next* link of the chain.
PROJECT="${PROJECT:-${PBS_PROJECT:-${PBS_ACCOUNT:-changeme}}}"

if [ "${PROJECT}" = "changeme" ]; then
    echo "ERROR: no NSCC project code." >&2
    echo "       ASPIRE 2A charges every job to a project (#PBS -P)." >&2
    echo "       Submit as:" >&2
    echo "         qsub -P <project> -v PROJECT=<project> splendor_ai/scripts/nscc_train.pbs" >&2
    echo "       Your codes are in the NSCC welcome mail (a personal" >&2
    echo "       allocation is usually personal-<nusnetid>)." >&2
    exit 2
fi

mkdir -p "${LOG_DIR}"
JOB_TAG="${PBS_JOBID:-local.$(date +%Y%m%d-%H%M%S)}"
LOG_FILE="${LOG_DIR}/train.${JOB_TAG}.log"

# Everything printed from here on goes to the terminal *and* to the log file.
exec > >(tee -a "${LOG_FILE}") 2>&1

echo "=== splendor-train ========================================="
echo "job        : ${JOB_TAG}   chain link ${CHAIN}/${MAX_CHAIN}"
echo "project    : ${PROJECT}"
echo "node       : $(hostname)"
echo "workdir    : ${REPO_ROOT}"
echo "run dir    : ${RUN_DIR}"
echo "config     : ${CONFIG}"
echo "started    : $(date -Is)"

# --- 2. software environment ------------------------------------------------
# Same modules/conda environment `nscc_setup.sh` created on the login node.
if ! command -v module >/dev/null 2>&1; then
    for candidate in /etc/profile.d/modules.sh /usr/share/Modules/init/bash; do
        # shellcheck disable=SC1090
        [ -r "${candidate}" ] && . "${candidate}" && break
    done
fi
if command -v module >/dev/null 2>&1; then
    module load anaconda 2>/dev/null || module load anaconda3 2>/dev/null \
        || module load miniforge3 2>/dev/null || true
    # CUDA itself is NOT loaded: the PyPI torch wheel bundles its own CUDA
    # runtime and only needs the host driver, which is always present.
fi
if command -v conda >/dev/null 2>&1; then
    # shellcheck disable=SC1091
    . "$(conda info --base)/etc/profile.d/conda.sh"
    conda activate "${ENV_NAME}" || { echo "cannot activate ${ENV_NAME}"; exit 1; }
fi
echo "python     : $(command -v python) — $(python -V 2>&1)"

# --- 3. threading and I/O ---------------------------------------------------
# The learner is one process and there are ~56 CPU actor processes.  If each of
# them let BLAS/OpenMP spawn its own thread pool the node would run 64x64
# threads and thrash.  One thread per process; parallelism comes from the
# process count, which the config sets.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1          # logs appear while the job runs, not at exit
export PYTHONHASHSEED=0            # reproducible dict/set iteration in workers
export MALLOC_ARENA_MAX=2          # glibc: keep 56 forked actors from bloating
export CUDA_DEVICE_MAX_CONNECTIONS=1
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1   # harmless single-process, needed if
                                           # WORLD_SIZE>1 is ever switched on
# Where torch caches its JIT/inductor artefacts — /tmp on a compute node is
# small and shared; keep it inside the run directory.
export TORCHINDUCTOR_CACHE_DIR="${REPO_ROOT}/${RUN_DIR}/.torch_cache"
export TRITON_CACHE_DIR="${TORCHINDUCTOR_CACHE_DIR}/triton"
mkdir -p "${TORCHINDUCTOR_CACHE_DIR}"

echo "--- GPUs"
nvidia-smi --query-gpu=index,name,memory.total,driver_version \
           --format=csv,noheader || echo "(nvidia-smi unavailable)"
echo "--- cores: $(nproc) visible"

# --- 4. resume or start fresh ----------------------------------------------
# The question is not "does the directory exist" — this very script created it
# two steps ago (${LOG_DIR} and ${TORCHINDUCTOR_CACHE_DIR} both live inside it),
# so that test was true even on the first link of a chain and every fresh run
# was submitted with `--resume` against a directory holding no state.  It
# happened to work (the trainer prints "no trainer_state.pt, starting fresh"),
# but it hid a real failure: a run whose checkpoint went missing looked exactly
# like a run that had never started.  The question is whether there is anything
# to resume FROM, which is exactly one file.
STATE_FILE="${RUN_DIR}/trainer_state.pt"
RESUME_ARG=""
if [ -f "${STATE_FILE}" ]; then
    RESUME_ARG="--resume ${RUN_DIR}"
    echo "--- resuming ${RUN_DIR} ($(du -h "${STATE_FILE}" | cut -f1) state)"
    ls -1 "${RUN_DIR}/checkpoints" 2>/dev/null | tail -n 3 | sed 's/^/      /'
elif [ -d "${RUN_DIR}/checkpoints" ] && \
     [ -n "$(ls -A "${RUN_DIR}/checkpoints" 2>/dev/null)" ]; then
    # Checkpoints but no trainer state: something removed or never wrote it.
    # Starting fresh here would silently overwrite a real run, so stop instead.
    echo "ERROR: ${RUN_DIR}/checkpoints has generation checkpoints but"        >&2
    echo "       ${STATE_FILE} is missing, so this job cannot resume the run." >&2
    echo "       Refusing to start a FRESH run on top of it.  Either restore"  >&2
    echo "       the state file, or move ${RUN_DIR} aside, or pass a different">&2
    echo "       RUN_DIR= to qsub."                                            >&2
    exit 2
else
    echo "--- fresh run: no ${STATE_FILE}"
fi

if [ ! -f "${CONFIG}" ]; then
    echo "ERROR: config ${CONFIG} not found — write it or pass CONFIG=... to qsub -v" >&2
    exit 2
fi

# --- 5. train ---------------------------------------------------------------
# `timeout --signal=INT` sends SIGINT (the same signal as Ctrl-C) a bit before
# PBS's walltime, so the trainer can finish its step, flush metrics.jsonl and
# write a checkpoint instead of being SIGKILLed mid-write.
#
# It signals the whole PROCESS GROUP, not just the trainer: every actor and
# every inference server gets the SIGINT at the same moment.  That is the
# behaviour this run wants, and all three now handle it explicitly —
#   * actors set a flag, finish the wave of `games_per_actor` games in flight,
#     ship its records and exit 0 (they used to die inside a search, losing
#     every finished-but-unshipped game);
#   * inference servers keep serving until their request queue goes quiet, for
#     up to `selfplay.stop_grace_s`, so nobody is stranded on a reply;
#   * the trainer drains the record queue, then writes weights and the
#     checkpoint FIRST and skips the final evaluation (`eval.final_eval_seconds`
#     defaults to 0 = skip on a signal).
# `timeout --foreground` would signal only the trainer and leave the children
# to be terminated by it; that loses the last wave, so it is deliberately NOT
# used.  --kill-after=10m is the backstop if any of the above wedges.
echo "--- starting training (self-imposed limit ${TRAIN_TIMEOUT})"
START_TS=$(date +%s)
# The trainer's flags are exactly: --config, --resume, --set, --evaluate,
# --warm-start, --print-config.  `--set KEY=VALUE` writes into the config tree
# and REFUSES a key RunConfig does not have, so the job id -- which is not a
# config leaf -- travels in the environment instead and is recorded in
# metrics.jsonl (the "run" and "summary" lines).  `--resume ${RUN_DIR}` already
# implies `run_dir=${RUN_DIR}`; the explicit override is what points a *fresh*
# run at this directory instead of at the config's own run_dir.
export SPLENDOR_JOB_ID="${JOB_TAG}"
timeout --signal=INT --kill-after=10m "${TRAIN_TIMEOUT}" \
    python -m splendor_ai.selfplay.train \
        --config "${CONFIG}" \
        ${RESUME_ARG} \
        --set run_dir="${RUN_DIR}"
STATUS=$?
END_TS=$(date +%s)
echo "--- training exited with status ${STATUS} after $(( (END_TS - START_TS) / 60 )) min"

# --- 6. a one-line summary of where the run stands --------------------------
if [ -f "${RUN_DIR}/metrics.jsonl" ]; then
    echo "--- last metrics line"
    tail -n 1 "${RUN_DIR}/metrics.jsonl"
fi
ls -l "${RUN_DIR}/weights/latest.pt" 2>/dev/null || \
    echo "note: no weights/latest.pt yet"

# --- 7. chain the next job --------------------------------------------------
# Exit codes: 0 = the trainer finished on its own, 124 = `timeout` stopped it
# because the walltime was nearly up (the normal case for a long run).  Any
# other code is a real failure and must not be re-submitted blindly — read the
# log, fix it, and qsub again by hand.  In particular:
#   2 = a bad configuration (a typo in --set, a missing config file)
#   3 = the trainer stopped itself: an actor exceeded its restart budget, or an
#       inference server died.  The checkpoint IS written; the traceback above
#       the "[train] aborted:" line is the failure to fix.
if [ -f "${STOP_FILE}" ]; then
    echo "=== STOP file present (${STOP_FILE}) — not re-submitting."
elif [ "${MAX_CHAIN}" -le 0 ] || [ "${CHAIN}" -ge "${MAX_CHAIN}" ]; then
    echo "=== chain limit reached (${CHAIN}/${MAX_CHAIN}) — not re-submitting."
elif [ "${STATUS}" -ne 0 ] && [ "${STATUS}" -ne 124 ]; then
    echo "=== training failed (status ${STATUS}) — NOT re-submitting."
    echo "    inspect ${LOG_FILE}, then:"
    echo "    qsub -P ${PROJECT} -v PROJECT=${PROJECT} splendor_ai/scripts/nscc_train.pbs"
else
    NEXT=$(( CHAIN + 1 ))
    echo "=== submitting chain link ${NEXT}"
    # -v passes variables into the next job's environment.  (The alternative
    #  style is to submit the successor at the *start* with
    #  `qsub -W depend=afterany:$PBS_JOBID`, which queues it while this one
    #  runs; end-of-job submission is used here because it can look at the
    #  exit status first.)
    cd "${REPO_ROOT}" && qsub \
        -P "${PROJECT}" \
        -v CHAIN=${NEXT},MAX_CHAIN=${MAX_CHAIN},RUN_DIR=${RUN_DIR},CONFIG=${CONFIG},ENV_NAME=${ENV_NAME},PROJECT=${PROJECT} \
        splendor_ai/scripts/nscc_train.pbs \
        && echo "    submitted." \
        || echo "    qsub failed — resubmit by hand."
fi

echo "finished   : $(date -Is)"
echo "log        : ${LOG_FILE}"
exit ${STATUS}
