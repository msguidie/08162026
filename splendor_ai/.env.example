# ─────────────────────────────────────────────────────────────────────────
# splendor_ai deployment worker — copy this file to `.env` and edit.
# splendor_ai 部署 worker 配置：把本文件复制为 `.env` 后修改。
#
# The worker reads `.env` from the current directory first, then from this
# `splendor_ai/` directory; real environment variables always win.
# worker 先读当前目录的 `.env`，再读 `splendor_ai/.env`；系统环境变量优先级最高。
# ─────────────────────────────────────────────────────────────────────────

# The server to dial out to. Use the https:// URL of your Render service in
# production, or http://127.0.0.1:10000 for a local server.
# 要连接的服务器地址。线上填 Render 的 https:// 域名，本地调试填 http://127.0.0.1:10000。
SERVER_URL=http://127.0.0.1:10000

# Shared secret. Must be byte-identical to AI_WORKER_SECRET in the Render
# environment; if it differs the server refuses the registration.
# 共享密钥，必须与 Render 环境变量 AI_WORKER_SECRET 完全一致，否则服务器会拒绝注册。
AI_WORKER_SECRET=change-me

# Name shown by GET /api/ai/status and in the lobby.
# 该名字会显示在 GET /api/ai/status 和大厅里。
WORKER_NAME=home-3060

# Directory holding the checkpoints. The worker looks for <mode>.pt first
# (ind2, ind3, ind4, ovt, team) and falls back to shared.pt. With no
# checkpoint at all it still runs, on the greedy ladder.
# 模型目录。先找 <模式>.pt（ind2/ind3/ind4/ovt/team），找不到就用 shared.pt。
# 完全没有模型时 worker 仍可运行，只是退化为贪心策略。
MODEL_DIR=models

# cuda | cpu | auto. `auto` picks cuda when torch sees a GPU.
# cuda | cpu | auto。`auto` 表示检测到 GPU 就用 cuda，否则用 cpu。
DEVICE=auto

# Simulation cap per move. A ceiling, not a target: the clock below normally
# stops the search first.
# 每步搜索的模拟次数上限。通常时间预算先到，这个值只是天花板。
SEARCH_SIMS=4000

# Soft budget: stop starting new simulations after this many milliseconds.
# 软时间预算（毫秒）：超过后不再开始新的模拟。
TIME_BUDGET_MS=1500

# Hard budget: never spend longer than this on one move, whatever happens.
# 硬时间预算（毫秒）：单步思考绝不超过这个时间。
HARD_BUDGET_MS=2500

# Number of determinization universes (K) sampled per search — the hidden
# information (deck order, other seats' blind reserves) is re-sampled K times.
# 确定化的“平行世界”数量 K：牌堆顺序和对手暗牌每步会被重采样 K 次。
UNIVERSES=16

# Set to 1 to average the root evaluation over the five colour rotations
# (more accurate, ~5x the cost of that single evaluation).
# 设为 1 时在根节点对五种颜色旋转做集成评估（更准，但该次评估约 5 倍开销）。
ROOT_ENSEMBLE=0

# Where moves.jsonl is written (one JSON line per answered move).
# 移动日志目录，moves.jsonl 每行一条已回复的走子记录。
LOG_DIR=logs

# DEBUG | INFO | WARN | ERROR
# 日志级别：DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ── advanced, rarely changed / 进阶选项，一般不用改 ──────────────────────

# Milliseconds kept in hand before the server's own deadline.
# 相对服务器截止时间预留的安全余量（毫秒）。
# DEADLINE_MARGIN_MS=400

# Reconnection backoff bounds in milliseconds (the worker retries for ever;
# a sleeping Render free-tier service simply wakes up and it re-registers).
# 断线重连的退避区间（毫秒）。worker 会无限重试：Render 免费实例休眠后自动重新注册。
# RECONNECT_DELAY_MS=1000
# RECONNECT_DELAY_MAX_MS=30000

# Fixed RNG seed for reproducible searches (0 = entropy from the OS).
# 固定随机种子以复现搜索结果（0 表示使用系统熵）。
# SEED=0
